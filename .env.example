# ==============================================================================
# KONFIGURASI SUPABASE (TugasKu) — OPSIONAL
# ==============================================================================
# 1. Salin file ini menjadi file baru bernama `.env.local` di root folder proyek:
#    cp .env.example .env.local
#
# 2. Dapatkan Project URL dan Project Anon Key dari Supabase Dashboard:
#    Masuk ke Project Anda -> Settings (ikon gerigi) -> API
#    - Project URL (URL publik project Anda)
#    - Project API Keys -> anon / public (Kunci enkripsi aman untuk frontend)
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=kunci_service_role_anda


# ==============================================================================
# KONFIGURASI BREVO / SENDINBLUE (Pengiriman Kode OTP Instan via HTTP API)
# ==============================================================================
# Keuntungan: 300 email gratis per hari, pengiriman instan (1-3 detik) tanpa delay SMTP.
#
# Langkah Setup (Hanya 2 Menit):
# 1. Buat akun gratis di: https://app.brevo.com
# 2. Buka menu: Profil (Kanan Atas) -> "SMTP & API" -> Tab "API Keys"
#    Link langsung: https://app.brevo.com/settings/keys/api
# 3. Klik tombol "Generate a new API key", beri nama "TugasKu", lalu salin kuncinya.
# 4. Email Pengirim (BREVO_SENDER_EMAIL) harus sama dengan email yang terdaftar/terverifikasi
#    di menu "Senders & IP" Brevo Anda (biasanya email yang dipakai untuk daftar Brevo).
# ==============================================================================

BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=email-anda-yang-terdaftar-di-brevo@gmail.com
BREVO_SENDER_NAME="TugasKu BSI"
